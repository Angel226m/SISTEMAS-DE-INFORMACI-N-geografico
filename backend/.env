# ══════════════════════════════════════════════════════════════════
# GeoRiesgo Perú — Variables de entorno v9.0
# Copiar a .env y ajustar valores antes de levantar docker compose
# ══════════════════════════════════════════════════════════════════

# ── Base de datos ────────────────────────────────────────────────
DB_PASSWORD=georiesgo_secret
POSTGRES_DB=georiesgo
POSTGRES_USER=georiesgo
DB_HOST=db
DB_PORT=5432

# URLs de conexión (construidas automáticamente por docker-compose)
DATABASE_URL=postgresql://georiesgo:georiesgo_secret@db:5432/georiesgo
DATABASE_URL_SYNC=postgresql://georiesgo:georiesgo_secret@db:5432/georiesgo

# Exponer puerto de BD al host (comentar en producción)
DB_PORT_EXPOSE=5432

# ── Redis (caché GeoJSON + rate limiting) ────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO (almacenamiento rasters COG + STAC) ───────────────────
MINIO_ROOT_USER=georiesgo
MINIO_ROOT_PASSWORD=georiesgo_raster_2024
MINIO_PASSWORD=georiesgo_raster_2024
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=georiesgo-rasters

# ── App ──────────────────────────────────────────────────────────
APP_ENV=production        # production | development
LOG_LEVEL=INFO
WORKERS=2                 # uvicorn workers (recomendado: 2 × CPUs)

# ── ETL ──────────────────────────────────────────────────────────
# 0 = No re-sincronizar al arrancar (BD ya tiene datos)
# 1 = Forzar re-sincronización completa al arrancar
FORCE_SYNC=0

# ── ML Engine ────────────────────────────────────────────────────
# Directorio donde se persisten los modelos entrenados
MODEL_DIR=/app/models

# ── Opcionales ───────────────────────────────────────────────────
# TZ=America/Lima
# RATE_LIMIT_GLOBAL=200/minute
# RATE_LIMIT_PESADO=20/minute